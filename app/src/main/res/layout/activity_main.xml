<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prayer Alarm"
            android:textColor="@color/navy"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Apni Nimaz Ke Waqt Set Karo"
            android:textColor="@color/navy2"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblFajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swFajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnFajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblZuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swZuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnZuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zuhr"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblAsr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblMaghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblIsha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swIsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnIsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lblJumma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- : --"
                android:textColor="@color/textDark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/swJumma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"/>
            <Button
                android:id="@+id/btnJumma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jumma"
                android:backgroundTint="@color/navy"
                android:textColor="@color/gold"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="App band ya phone lock ho, alarm phir bhi bajega."
            android:textColor="@color/navy2"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
